{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tokscale-monitor",
  "version": "0.1.0",
  "identifier": "com.shusakusawada.tokscale-monitor",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
      "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "tokscale-monitor",
        "width": 900,
        "height": 800
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "menuOnLeftClick": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
